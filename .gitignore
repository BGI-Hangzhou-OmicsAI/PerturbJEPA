# Publish only the source package and the four experiment recipes.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/LICENSE
!/requirements-train.txt
!/configs/
!/src/

/configs/*
!/configs/parse10m_tiny_visit_35400.yaml
!/configs/parse10m_tiny_epoch_35400.yaml
!/configs/parse10m_state_tiny_visit_35400.yaml
!/configs/parse10m_state_tiny_epoch_35400.yaml

/src/**/README.md
/src/process/Parse10M/dashboard.html
/src/process/Parse10M/dashboard.py

# Credentials, generated files and environments.
.env
.env.*
.venv/
venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.nbc
*.nbi
*.log
*.tmp
*.safetensors
*.pt
*.pth
*.bin
*.tar.gz
